<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Chat history and vault database are private user data. -->
        <exclude domain="database" path="." />
        <!-- Preferences DataStore contains the Gemini API credential. -->
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <!-- Keystore keys are device-bound; do not transfer ciphertext without its key. -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
