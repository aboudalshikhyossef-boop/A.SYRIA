<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="prayer_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Android Keystore keys are device-bound; do not transfer their ciphertext. -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="prayer_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
